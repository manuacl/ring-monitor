#!/usr/bin/env bash
# Pre-commit hook:
#   1. Reject any source/test file > 500 lines.
#   2. qmlformat --inplace on staged .qml files.
#   3. qmllint on staged .qml files.
#
# Enable once per clone:
#     git config core.hooksPath .githooks

set -e

QMLLINT="${QMLLINT:-qmllint-qt6}"
QMLFORMAT="${QMLFORMAT:-qmlformat-qt6}"
MAX_LINES=500

# ── 1. Line-count gate ──────────────────────────────────────────────
# Applies to source + tests. Docs can grow as needed. If a file goes
# over, split it (extract logic to a .js module, components to their
# own .qml file) — see CLAUDE.md "Working rules".
mapfile -d '' line_check_files < <(
    git diff --cached --name-only --diff-filter=ACMR -z -- \
        'contents/ui/*.qml' \
        'contents/ui/*.js' \
        'contents/ui/core/*.qml' \
        'contents/ui/core/*.js' \
        'contents/ui/platforms/plasma/*.qml' \
        'tests/*.test.mjs' \
        'tests/qml/*.qml'
)

if [ ${#line_check_files[@]} -gt 0 ]; then
    too_big=()
    for f in "${line_check_files[@]}"; do
        [ -f "$f" ] || continue
        lines=$(wc -l < "$f")
        if [ "$lines" -gt "$MAX_LINES" ]; then
            too_big+=("$f ($lines lines)")
        fi
    done
    if [ ${#too_big[@]} -gt 0 ]; then
        echo "pre-commit: file(s) over the $MAX_LINES-line limit:" >&2
        for entry in "${too_big[@]}"; do
            echo "  - $entry" >&2
        done
        echo "" >&2
        echo "Split it: extract pure logic to a .js module, or pull a" >&2
        echo "sub-component into its own .qml file. See CLAUDE.md." >&2
        echo "Bypass with --no-verify only if you really must." >&2
        exit 1
    fi
fi

# ── 2 & 3. qmlformat + qmllint on staged .qml files ─────────────────
if ! command -v "$QMLLINT" >/dev/null 2>&1; then
    echo "pre-commit: '$QMLLINT' not found, skipping QML checks." >&2
    echo "            install qt6-qtdeclarative-devel (rpm-ostree / dnf) to enable." >&2
    exit 0
fi

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.qml')

if [ ${#staged[@]} -eq 0 ]; then
    exit 0
fi

if command -v "$QMLFORMAT" >/dev/null 2>&1; then
    "$QMLFORMAT" --inplace "${staged[@]}"
    git add -- "${staged[@]}"
fi

if ! "$QMLLINT" "${staged[@]}"; then
    echo "" >&2
    echo "pre-commit: qmllint reported warnings/errors above — commit aborted." >&2
    echo "            fix them, or commit with --no-verify if you really must." >&2
    exit 1
fi
